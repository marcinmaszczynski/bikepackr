---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const accommodationLabels: Record<string, string> = {
  hotel: "Hotel / Pensjonat",
  tent: "Namiot",
  hammock: "Hamak",
  bivy: "Bivy bag",
  hostel: "Hostel / Schronisko",
};

const supabase = createClient(Astro.request.headers, Astro.cookies);

const trips = supabase
  ? ((
      await supabase
        .from("trips")
        .select("id, title, start_date, accommodation_type, created_at")
        .order("created_at", { ascending: false })
    ).data ?? [])
  : [];
---

<Layout title="Dashboard — Bikepackr">
  <div class="bg-cosmic min-h-screen p-4 py-8">
    <div class="mx-auto max-w-lg space-y-6">
      <div class="flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Moje plany
        </h1>
        <a
          href="/trips/new"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Nowy plan
        </a>
      </div>

      {
        trips.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
            <p class="text-blue-100/60">Nie masz jeszcze żadnych planów.</p>
            <a href="/trips/new" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
              Wygeneruj swój pierwszy plan →
            </a>
          </div>
        ) : (
          <ul class="space-y-3">
            {trips.map((trip) => (
              <li>
                <a
                  href={`/trips/${trip.id}`}
                  class="block rounded-2xl border border-white/10 bg-white/10 p-5 text-white backdrop-blur-xl transition-colors hover:bg-white/20"
                >
                  <p class="font-semibold">{trip.title ?? "Plan bez nazwy"}</p>
                  <p class="mt-1 text-sm text-blue-100/60">
                    {trip.start_date} · {accommodationLabels[trip.accommodation_type] ?? trip.accommodation_type}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <form method="POST" action="/api/auth/signout" class="text-center">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
